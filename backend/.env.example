NODE_ENV=development

# Ports and Docker Compose project
# The defaults are the ports of the main checkout (slot 0).
# scripts/worktree-add.sh sets these values in a worktree. See docs/worktrees.md
# BACKEND_PORT=4100
# DYNAMODB_PORT=4102
# DYNAMODB_ADMIN_PORT=4103
# PHOENIX_PORT=4104
# COMPOSE_PROJECT_NAME=budget-<name>

# AWS Configuration
# AWS_DEFAULT_REGION is required by LangChain's Bedrock provider (langchain-aws)
# which reads it directly and throws if unset.
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# Auth0
# AUTH_AUDIENCE=https://personal-budget-tracker
# AUTH_CLAIM_NAMESPACE=https://personal-budget-tracker
# AUTH_ISSUER=https://<TENANT>.<REGION>.auth0.com

# Cognito
AUTH_CLAIM_NAMESPACE=https://personal-budget-tracker
AUTH_CLIENT_ID=<USER_POOL_CLIENT_ID>
AUTH_ISSUER=https://cognito-idp.<REGION>.amazonaws.com/<USER_POOL_ID>

# Database Configuration
DYNAMODB_ENDPOINT=http://localhost:4102

# Database Table Names
ACCOUNTS_TABLE_NAME=Accounts
CATEGORIES_TABLE_NAME=Categories
CHAT_MESSAGES_TABLE_NAME=ChatMessages
MIGRATIONS_TABLE_NAME=Migrations
TELEGRAM_BOTS_TABLE_NAME=TelegramBots
TRANSACTIONS_TABLE_NAME=Transactions
TREND_PRESETS_TABLE_NAME=TrendPresets
USERS_TABLE_NAME=Users

# AI Configuration
# AWS_BEARER_TOKEN_BEDROCK is read internally by LangChain's Bedrock provider
# for API-key authentication in local/dev environments.
AWS_BEARER_TOKEN_BEDROCK=<your_bedrock_api_key> # Long-term API key
# OPENAI_API_KEY is read by LangChain's OpenAI provider for openai:* models
# OPENAI_API_KEY=<your-openai-api-key>
# LANGCHAIN_MAX_TOKENS=2000
# LANGCHAIN_MODEL_ID=bedrock:openai.gpt-oss-120b-1:0
# LANGCHAIN_TEMPERATURE=0.2
# LANGCHAIN_TIMEOUT=30

# Application Configuration
# CHAT_HISTORY_MAX_MESSAGES=20
# CHAT_MESSAGE_TTL_SECONDS=86400 # 24 hours in seconds
API_BASE_URL=http://localhost:4100

# LangSmith Tracing
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=<your-langsmith-api-key>
# LANGSMITH_AGENT_ID=<your-langsmith-agent-id>
# LANGSMITH_AGENT_ENVIRONMENT=<local|development|staging|production>

# Development Seed Data
# `npm run db:seed` creates this user in the database before it seeds the sample data.
# Use the email of an existing Cognito user, so that the user can sign in.
# DEV_USER_EMAIL=
