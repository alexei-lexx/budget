# Dev server port
# The default is the port of the main checkout (slot 0).
# scripts/worktree-add.sh sets it in a worktree. See docs/worktrees.md
# FRONTEND_PORT=4101

# GraphQL API endpoint
VITE_GRAPHQL_ENDPOINT=http://localhost:4100/graphql

# MCP endpoint
VITE_MCP_ENDPOINT=http://localhost:4100/mcp

# Auth0
# VITE_AUTH_AUDIENCE=https://personal-budget-tracker
# VITE_AUTH_CLIENT_ID=<CLIENT_ID>
# VITE_AUTH_ISSUER=https://<TENANT>.<REGION>.auth0.com
# VITE_AUTH_SCOPE=openid profile email offline_access

# Cognito
VITE_AUTH_CLIENT_ID=<USER_POOL_CLIENT_ID>
VITE_AUTH_ISSUER=https://cognito-idp.<REGION>.amazonaws.com/<USER_POOL_ID>
VITE_AUTH_SCOPE=openid profile email
VITE_AUTH_UI_URL=https://<DOMAIN_PREFIX>.auth.<REGION>.amazoncognito.com
