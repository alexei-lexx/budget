#!/usr/bin/env bash
# Prepare an Amp orb: Docker, the pinned Node.js, npm dependencies, env files, and local DynamoDB tables.
# Must be non-interactive and idempotent. Amp runs it again on a stale snapshot.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  echo "==> $1"
  SECONDS=0
}

done_step() {
  echo "    done in ${SECONDS}s"
}

# Docker runs DynamoDB Local (see backend/docker-compose.yml).
# The socket gets the group of the orb user, so running processes can use Docker without a new login.
step "Docker"
if ! dpkg -s docker-compose-plugin >/dev/null 2>&1; then
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq docker-compose-plugin
fi
socket_dropin=/etc/systemd/system/docker.socket.d/amp-orb.conf
if [ ! -f "$socket_dropin" ]; then
  sudo mkdir -p "$(dirname "$socket_dropin")"
  printf '[Socket]\nSocketGroup=%s\n' "$(id -gn)" | sudo tee "$socket_dropin" >/dev/null
  sudo systemctl daemon-reload
  sudo systemctl stop docker.service docker.socket 2>/dev/null || true
fi
sudo systemctl start docker.socket docker.service
done_step

# Node.js version comes from .tool-versions
step "Node.js (mise)"
if [ ! -x "$HOME/.local/bin/mise" ]; then
  curl -fsSL https://mise.run | MISE_QUIET=1 sh
fi
"$HOME/.local/bin/mise" trust --quiet "$repo_root/.tool-versions"
"$HOME/.local/bin/mise" install node
mise_shims="$HOME/.local/share/mise/shims"
export PATH="$mise_shims:$PATH"

# Login shells (Amp and orb services) get the mise shims.
# Outside a folder with .tool-versions, the shims use the system Node.js.
profile_marker="# budget: mise shims for the Node.js version in .tool-versions"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >>"$HOME/.bash_profile" <<EOF

$profile_marker
case ":\$PATH:" in
  *":$mise_shims:"*) ;;
  *) export PATH="$mise_shims:\$PATH" ;;
esac
EOF
fi
echo "    node $(node -v)"
done_step

# OpenSpec CLI for spec-driven development (see openspec/ and the openspec-* skills).
# ~/.local/bin is on the PATH of login shells.
step "OpenSpec CLI"
openspec_version=2.1.0
if [ "$("$HOME/.local/bin/openspec" --version 2>/dev/null)" != "$openspec_version" ]; then
  npm install --global --prefix "$HOME/.local" --no-audit --no-fund --no-update-notifier --loglevel=error \
    "@fission-ai/openspec@$openspec_version"
fi
echo "    openspec $("$HOME/.local/bin/openspec" --version)"
done_step

# npm ci always deletes node_modules, so skip it when the installed tree matches the lockfile.
# npm writes node_modules/.package-lock.json at the end of each install.
for pkg in backend frontend infra-cdk; do
  step "npm dependencies: $pkg"
  marker="$pkg/node_modules/.amp-orb-lock"
  fingerprint="$(node -v) $(sha256sum "$pkg/package-lock.json" | cut -d' ' -f1)"
  if [ -f "$marker" ] && [ "$(cat "$marker")" = "$fingerprint" ]; then
    echo "    up to date"
  else
    (cd "$pkg" && npm ci --no-audit --no-fund --no-update-notifier --loglevel=error)
    echo "$fingerprint" >"$marker"
  fi
  done_step
done

# Env files from templates; keep existing files.
step "Env files"
for pair in \
  backend/.env.example:backend/.env \
  backend/.env.test.example:backend/.env.test \
  frontend/.env.example:frontend/.env \
  infra-cdk/.env.example:infra-cdk/.env; do
  src="${pair%%:*}"
  dst="${pair#*:}"
  [ -f "$dst" ] || cp -- "$src" "$dst"
done
done_step

# Pull the DynamoDB images and create the development and test tables.
# The table data stays in backend/docker/dynamodb. The container stops at the end of setup.
step "DynamoDB Local"
(
  cd backend
  docker compose --profile db pull --quiet
  docker compose --profile db up -d --wait
  timeout 30 bash -c 'until curl -s http://localhost:4102/ >/dev/null; do sleep 1; done'
  npm run --silent db:create
  npm run --silent test:db:create
  docker compose --profile db stop
)
done_step
